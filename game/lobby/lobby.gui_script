local ui = require("game.utils.ui")
local settings = require("game.settings")

-------------------------------
-- Defold lifecycle functions:
-------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")

	local username = "user" .. tostring(math.floor(math.random() * 100000))
	gui.set_text(gui.get_node("username"), username)
	self.fusion_available = settings.LOCAL_PLATFORMER or settings.FUSION_AVAILABLE
	self.fusion_configured = settings.LOCAL_PLATFORMER or settings.has_fusion_app_id()

	if settings.LOCAL_PLATFORMER then
		ui.hide("login_panel")
		msg.post(".", "start_connect_flow")
	elseif not self.fusion_available then
		gui.set_text(gui.get_node("title_text"), "FUSION UNAVAILABLE")
		gui.set_text(gui.get_node("start_game_text"), "USE HTML5 BUILD")
	elseif not self.fusion_configured then
		gui.set_text(gui.get_node("title_text"), "FUSION APP ID MISSING")
		gui.set_text(gui.get_node("start_game_text"), "ONLINE DISABLED")
	end
end

function on_input(self, action_id, action)
	local username = ui.input(self, "username", action_id, action)
	local roomname = ui.input(self, "roomname", action_id, action)
	if ui.button(self, "start_offline", action) then
		settings.enable_offline_session()
		ui.hide("login_panel")
		msg.post(".", "start_connect_flow")
		return
	end
	if ui.button(self, "start_game", action) then
		if not self.fusion_available then
			return
		end
		if not self.fusion_configured then
			gui.set_text(gui.get_node("title_text"), "ADD APP ID AND REBUILD")
			return
		end
		ui.hide("login_panel")
		msg.post(".", "start_connect_flow", { username = username, roomname = roomname })
	end
	if action.released and action_id == hash("toggle_debug") then
		msg.post("@system:", "toggle_physics_debug")
	end
end
