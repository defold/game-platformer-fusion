local PLAYER_URL = "/player"

local CAMERA_DISTANCE = 9.0
local CAMERA_HEIGHT = 4.0
local CAMERA_PITCH = math.rad(-20.0)
local CAMERA_TARGET_HEIGHT = 2.0
local POSITION_SMOOTH_SPEED = 10.0
local ROTATION_SMOOTH_SPEED = 4.0

local function lerp_angle(from, to, t)
	local delta = to - from
	delta = (delta + math.pi) % (math.pi * 2.0) - math.pi
	return from + delta * t
end

function init(self)
	self.smoothed_position = go.get_position()
	self.smoothed_yaw = 0.0
	print("camera_follow initialized")
end

function update(self, dt)
	local player_position = go.get_position(PLAYER_URL)
	local player_rotation = go.get_rotation(PLAYER_URL)
	local player_forward = vmath.rotate(player_rotation, vmath.vector3(0.0, 0.0, 1.0))
	local flat_forward = vmath.normalize(vmath.vector3(player_forward.x, 0.0, player_forward.z))

	local target = player_position + vmath.vector3(0.0, CAMERA_TARGET_HEIGHT, 0.0)
	local camera_position = target - flat_forward * CAMERA_DISTANCE + vmath.vector3(0.0, CAMERA_HEIGHT, 0.0)
	local yaw = math.atan2(flat_forward.x, flat_forward.z) + math.pi

	local position_alpha = 1.0 - math.exp(-POSITION_SMOOTH_SPEED * dt)
	local rotation_alpha = 1.0 - math.exp(-ROTATION_SMOOTH_SPEED * dt)

	self.smoothed_position = self.smoothed_position + (camera_position - self.smoothed_position) * position_alpha
	self.smoothed_yaw = lerp_angle(self.smoothed_yaw, yaw, rotation_alpha)

	go.set_position(self.smoothed_position)
	go.set_rotation(vmath.quat_rotation_y(self.smoothed_yaw) * vmath.quat_rotation_x(CAMERA_PITCH))
end
