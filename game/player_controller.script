---@class PlayerControllerState
---@field turn_left boolean
---@field turn_right boolean
---@field move_forward boolean
---@field move_back boolean
---@field jump_queued boolean
---@field grounded boolean
---@field velocity vector3
---@field movement_vector vector3
---@field yaw number
---@field correction vector3

local ACTION_JUMP = hash("jump")
local ACTION_RUN_FORWARD = hash("run_forward")
local ACTION_RUN_BACKWARD = hash("run_backward")
local ACTION_TURN_LEFT = hash("turn_left")
local ACTION_TURN_RIGHT = hash("turn_right")
local CONTACT_POINT_RESPONSE = hash("contact_point_response")

local MOVE_SPEED = 6.0
local BACKWARD_SPEED = 4.0
local TURN_SPEED = math.rad(160.0)
local JUMP_SPEED = 10.5
local GRAVITY = -28.0
local GROUND_NORMAL_Y = 0.6
local FALL_RESPAWN_Y = -10.0
local RESPAWN_POSITION = vmath.vector3(0.0, 2.0, 0.0)

local function update_boolean_action(action, current_value)
	if action.pressed then
		return true
	end
	if action.released then
		return false
	end
	return current_value
end

local function get_turn_axis(self)
	local turn_axis = 0.0
	if self.turn_left then
		turn_axis = turn_axis + 1.0
	end
	if self.turn_right then
		turn_axis = turn_axis - 1.0
	end
	return turn_axis
end

function init(self)
	self.turn_left = false
	self.turn_right = false
	self.move_forward = false
	self.move_back = false
	self.jump_queued = false
	self.grounded = false
	self.velocity = vmath.vector3()
	self.movement_vector = vmath.vector3(0.0, 0.0, 1.0)
	self.yaw = 0.0
	self.correction = vmath.vector3()

	msg.post(".", "acquire_input_focus")
	print("player_controller initialized")
end

function final(self)
	msg.post(".", "release_input_focus")
end

function update(self, dt)
	local was_grounded = self.grounded
	self.grounded = false
	self.correction = vmath.vector3()

	local turn_axis = get_turn_axis(self)
	self.yaw = self.yaw + turn_axis * TURN_SPEED * dt
	self.movement_vector.x = math.sin(self.yaw)
	self.movement_vector.y = 0.0
	self.movement_vector.z = math.cos(self.yaw)

	local move_axis = 0.0
	if self.move_forward then
		move_axis = move_axis + 1.0
	end
	if self.move_back then
		move_axis = move_axis - 1.0
	end

	local speed = move_axis >= 0.0 and MOVE_SPEED or BACKWARD_SPEED
	self.velocity.x = self.movement_vector.x * move_axis * speed
	self.velocity.z = self.movement_vector.z * move_axis * speed
	self.velocity.y = self.velocity.y + GRAVITY * dt

	if self.jump_queued and was_grounded then
		self.velocity.y = JUMP_SPEED
		self.grounded = false
	end
	self.jump_queued = false

	local position = go.get_position()
	position = position + self.velocity * dt

	if position.y <= FALL_RESPAWN_Y then
		position = vmath.vector3(RESPAWN_POSITION)
		self.velocity = vmath.vector3()
		self.grounded = false
		self.jump_queued = false
	end

	go.set_position(position)
	go.set_rotation(vmath.quat_rotation_y(self.yaw))
end

function on_input(self, action_id, action)
	if action_id == ACTION_TURN_LEFT then
		self.turn_left = update_boolean_action(action, self.turn_left)
	elseif action_id == ACTION_TURN_RIGHT then
		self.turn_right = update_boolean_action(action, self.turn_right)
	elseif action_id == ACTION_RUN_FORWARD then
		self.move_forward = update_boolean_action(action, self.move_forward)
	elseif action_id == ACTION_RUN_BACKWARD then
		self.move_back = update_boolean_action(action, self.move_back)
	elseif action_id == ACTION_JUMP then
		if action.pressed then
			self.jump_queued = true
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == CONTACT_POINT_RESPONSE then
		if message.distance > 0.0 then
			local projection = vmath.dot(self.correction, message.normal)
			local compensation = (message.distance - projection) * message.normal
			self.correction = self.correction + compensation
			go.set_position(go.get_position() + compensation)

			if message.normal.y > GROUND_NORMAL_Y and self.velocity.y < 0.0 then
				self.grounded = true
				self.velocity.y = 0.0
			end
		end
	end
end
