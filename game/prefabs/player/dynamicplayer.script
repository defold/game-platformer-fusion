---@class DynamicPlayerControllerState
---@field turn_left boolean
---@field turn_right boolean
---@field move_forward boolean
---@field move_back boolean
---@field jump_buffer number
---@field coyote_time number
---@field ground_contact_ttl number
---@field animation string|nil
---@field safe_spots vector3[]

local ACTION_JUMP = hash("jump")
local ACTION_RUN_FORWARD = hash("run_forward")
local ACTION_RUN_BACKWARD = hash("run_backward")
local ACTION_TURN_LEFT = hash("turn_left")
local ACTION_TURN_RIGHT = hash("turn_right")
local CONTACT_POINT_RESPONSE = hash("contact_point_response")

local FORWARD_VECTOR = vmath.vector3(0.0, 0.0, 1.0)
local ZERO_VECTOR = vmath.vector3()

local GROUND_NORMAL_Y = 0.6
local GROUND_CONTACT_MEMORY = 0.1
local JUMP_BUFFER_DURATION = 0.12
local COYOTE_TIME_DURATION = 0.10
local FALL_RESPAWN_Y = -14.0
local MAX_SAFE_SPOTS = 50
local RESPAWN_HEIGHT_OFFSET = 0.6

local GROUND_MOVE_FORCE = 10000
local AIR_MOVE_FORCE = 8000
local MAX_GROUND_SPEED = 2
local MAX_AIR_SPEED = 5
local TURN_ANGULAR_SPEED = math.rad(50.0)
local JUMP_IMPULSE = 130

local function play_animation(self, id)
	if self.animation == id then
		return
	end
	self.animation = id
	model.play_anim("#model", id, go.PLAYBACK_LOOP_FORWARD)
end

local function record_safe_spot(self, position)
	table.insert(self.safe_spots, vmath.vector3(position))
	if #self.safe_spots > MAX_SAFE_SPOTS then
		table.remove(self.safe_spots, 1)
	end
end

local function get_closest_safe_spot(self, position)
	return self.safe_spots[1]
end

local function respawn_if_fallen(self)
	local current_position = go.get_position()
	if current_position.y > FALL_RESPAWN_Y then
		return false
	end

	local closest_safe_spot = get_closest_safe_spot(self, current_position)
	local respawn_position = vmath.vector3(
		closest_safe_spot.x,
		closest_safe_spot.y + RESPAWN_HEIGHT_OFFSET,
		closest_safe_spot.z
	)

	respawn_position = self.initial_spawn_point
	go.set_position(respawn_position)
	go.set("#collisionobject", "linear_velocity", ZERO_VECTOR)
	go.set("#collisionobject", "angular_velocity", ZERO_VECTOR)

	self.ground_contact_ttl = 0.0
	self.coyote_time = 0.0
	self.jump_buffer = 0.0
	play_animation(self, "idle")

	print("player respawned", respawn_position)
	return true
end

local function update_boolean_action(action, current_value)
	if action.pressed then
		return true
	end
	if action.released then
		return false
	end
	return current_value
end

local function get_turn_axis(self)
	local axis = 0.0
	if self.turn_left then
		axis = axis + 1.0
	end
	if self.turn_right then
		axis = axis - 1.0
	end
	return axis
end

local function get_move_axis(self)
	local axis = 0.0
	if self.move_forward then
		axis = axis + 1.0
	end
	if self.move_back then
		axis = axis - 1.0
	end
	return axis
end

local function get_planar_forward()
	local forward = vmath.rotate(go.get_world_rotation(), FORWARD_VECTOR)
	forward.y = 0.0
	local length = vmath.length(forward)
	if length <= 0.0001 then
		return FORWARD_VECTOR
	end
	return forward / length
end

local function apply_force(force, dt)
	msg.post("#collisionobject", "apply_force", {
		force = force * dt,
		position = go.get_world_position(),
	})
end

local function apply_turning(self)
	local turn_axis = get_turn_axis(self)
	local angular_velocity = go.get("#collisionobject", "angular_velocity")
	angular_velocity.x = 0.0
	angular_velocity.y = turn_axis * TURN_ANGULAR_SPEED
	angular_velocity.z = 0.0
	go.set("#collisionobject", "angular_velocity", angular_velocity)
end

local function apply_horizontal_movement(self, grounded, dt)
	local move_axis = get_move_axis(self)
	local velocity = go.get("#collisionobject", "linear_velocity")

	-- immediately stop movement if not holding down a movement key
	if move_axis == 0.0 then
		velocity.x = 0.0
		velocity.z = 0.0
		go.set("#collisionobject", "linear_velocity", velocity)
		return
	end

	-- apply movement force on plane
	local planar_velocity = vmath.vector3(velocity.x, 0.0, velocity.z)
	local forward = get_planar_forward()
	local force_strength = grounded and GROUND_MOVE_FORCE or AIR_MOVE_FORCE
	apply_force(forward * move_axis * force_strength, dt)

	-- clamp speed
	local speed = vmath.length(planar_velocity)
	local max_speed = grounded and MAX_GROUND_SPEED or MAX_AIR_SPEED
	if speed > max_speed and move_axis ~= 0.0 then
		local velocity_dir = planar_velocity / speed
		local input_dir = forward * move_axis
		if vmath.dot(velocity_dir, input_dir) > 0.0 then
			local clamped_planar = velocity_dir * max_speed
			velocity.x = clamped_planar.x
			velocity.z = clamped_planar.z
			go.set("#collisionobject", "linear_velocity", velocity)
		end
	end
end

local function try_jump(self, dt)
	if self.jump_buffer <= 0.0 or self.coyote_time <= 0.0 then
		return
	end

	local impulse_force = vmath.vector3(0.0, JUMP_IMPULSE, 0.0) / dt
	msg.post("#collisionobject", "apply_force", {
		force = impulse_force,
		position = go.get_world_position(),
	})

	self.jump_buffer = 0.0
	self.coyote_time = 0.0
	self.ground_contact_ttl = 0.0
	play_animation(self, "jump")
end

function init(self)
	print("player", fusion.has_authority())

	self.turn_left = false
	self.turn_right = false
	self.move_forward = false
	self.move_back = false
	self.jump_buffer = 0.0
	self.coyote_time = 0.0
	self.ground_contact_ttl = 0.0
	self.animation = nil
	self.safe_spots = { vmath.vector3(go.get_position()) }

	--go.set("#collisionobject", "angular_velocity", ZERO_VECTOR)
	msg.post("#collisionobject", "disable")
	play_animation(self, "idle")
	self.initial_spawn_point = go.get_position()
end

function fixed_update(self, dt)
	if not fusion.has_authority() then
		return
	end

	if respawn_if_fallen(self) then
		return
	end

	self.jump_buffer = math.max(0.0, self.jump_buffer - dt)
	self.ground_contact_ttl = math.max(0.0, self.ground_contact_ttl - dt)

	local grounded = self.ground_contact_ttl > 0.0
	if grounded then
		self.coyote_time = COYOTE_TIME_DURATION
		record_safe_spot(self, go.get_position())
	else
		self.coyote_time = math.max(0.0, self.coyote_time - dt)
	end

	apply_turning(self)
	apply_horizontal_movement(self, grounded, dt)
	try_jump(self, dt)
end

function update(self, dt)
	if not fusion.has_authority() then
		return
	end

	local grounded = self.ground_contact_ttl > 0.0
	local velocity = go.get("#collisionobject", "linear_velocity")
	local planar_speed = vmath.length(vmath.vector3(velocity.x, 0.0, velocity.z))

	if grounded then
		if planar_speed < 0.5 then
			--print("idle")
			play_animation(self, "idle")
		else
			--print("sprint")
			play_animation(self, "walk")
		end
	else
		if velocity.y > 0.1 then
			play_animation(self, "jump")
		else
			--print("fall")
			play_animation(self, "jump")
		end
	end

	physics.wakeup("#collisionobject")
end

function on_input(self, action_id, action)
	if action_id == ACTION_TURN_LEFT then
		self.turn_left = update_boolean_action(action, self.turn_left)
	elseif action_id == ACTION_TURN_RIGHT then
		self.turn_right = update_boolean_action(action, self.turn_right)
	elseif action_id == ACTION_RUN_FORWARD then
		self.move_forward = update_boolean_action(action, self.move_forward)
	elseif action_id == ACTION_RUN_BACKWARD then
		self.move_back = update_boolean_action(action, self.move_back)
	elseif action_id == ACTION_JUMP then
		if action.pressed then
			self.jump_buffer = JUMP_BUFFER_DURATION
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == fusion.EVENT_OBJECT_READY then
		if fusion.has_authority() then
			msg.post(".", "acquire_input_focus")
			--go.set_parent("/camera", go.get_id())
			go.set("#collisionobject", "angular_velocity", ZERO_VECTOR)
			msg.post("#collisionobject", "enable")
			physics.wakeup("#collisionobject")
		end
	end

	if message_id ~= CONTACT_POINT_RESPONSE then
		return
	end

	--print("contact point")
	if message.other_group == hash("platform") and message.normal.y > GROUND_NORMAL_Y then
		self.ground_contact_ttl = GROUND_CONTACT_MEMORY
	end
end
