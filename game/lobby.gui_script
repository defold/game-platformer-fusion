local button = require("game.utils.button")

function init(self)
	msg.post(".", "acquire_input_focus")
end


function on_input(self, action_id, action)
	if button(self, "connect_button", action) then
		button.hide("connect_button")
		msg.post(".", "start_connect_flow")
	end
	if action.released and action_id == hash("toggle_debug") then
		msg.post("@system:", "toggle_physics_debug")
	end
end